{
  "manifest_version": 3,
  "name": "xsched gate0 probe",
  "version": "0.0.6",
  "description": "Read-only X Scheduled probe. No permissions or network; only button/panel positions saved locally on x.com.",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "reader.js",
        "skeleton.js",
        "ui.js",
        "position.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
