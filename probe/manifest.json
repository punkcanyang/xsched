{
  "manifest_version": 3,
  "name": "xsched quick slots",
  "version": "0.3.0",
  "description": "X native schedule helper and local calendar. Stores schedule times and 20-character previews; opens a uniquely matching native row only on request. Never confirms, deletes or sends. No permissions or background network.",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "reader.js",
        "skeleton.js",
        "ui.js",
        "position.js",
        "quick.js",
        "composer.js",
        "overview.js",
        "calendar-store.js",
        "calendar.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
