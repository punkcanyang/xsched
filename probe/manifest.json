{
  "manifest_version": 3,
  "name": "xsched quick slots",
  "version": "0.1.1",
  "description": "X native schedule field helper; never confirms or sends. No permissions or network; only positions stored locally.",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "reader.js",
        "skeleton.js",
        "ui.js",
        "position.js",
        "quick.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
