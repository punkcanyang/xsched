{
  "scope": "Production calendar.js + overview.js in isolated component fixture; no extension installed",
  "steps": [
    {
      "step": "desktop",
      "focus": {
        "document": "DIV",
        "shadow": "calendar-full"
      }
    },
    {
      "step": "after-next-month",
      "focus": {
        "document": "BODY",
        "shadow": null
      }
    },
    {
      "step": "tab-after-month",
      "focus": {
        "document": "DIV",
        "shadow": "calendar-previous"
      }
    },
    {
      "step": "escape",
      "closed": true,
      "focus": {
        "document": "DIV",
        "shadow": "calendar-expand"
      }
    }
  ],
